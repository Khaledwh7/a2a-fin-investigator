# ============================================================================
# AI Financial Investigation Assistant — configuration
# Copy to `.env` and adjust. NEVER commit the real .env (it's gitignored).
# ============================================================================

ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000

# --- A2A protocol -----------------------------------------------------------
A2A_PROTOCOL_VERSION=1.0
A2A_ACCEPT_LEGACY_V03=true

# --- Datastore --------------------------------------------------------------
# SQLite by default (zero-setup). Swap for Postgres in docker-compose.
DATABASE_URL=sqlite+aiosqlite:///./data/investigations.db

# --- Peer registry (static discovery + trust allowlist) ---------------------
# Single-process default: all six agents on one host. In docker each becomes a
# service name. A role not listed here can neither call nor be called.
ORCHESTRATOR_URL=http://localhost:8000/a2a/orchestrator
KYC_URL=http://localhost:8000/a2a/kyc
AML_URL=http://localhost:8000/a2a/aml
SANCTIONS_URL=http://localhost:8000/a2a/sanctions
FRAUD_URL=http://localhost:8000/a2a/fraud
RISK_URL=http://localhost:8000/a2a/risk
REPORTING_URL=http://localhost:8000/a2a/reporting

# --- Security ---------------------------------------------------------------
# JWT signing secret. MUST be >= 32 bytes (RFC 7518). Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-32byte-minimum-secret!
JWT_ISSUER=a2a-fin-investigator
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900

# Security controls. The first two ship ON — the app runs secured by default and
# the test suite exercises that configuration. Turn them off only to inspect the
# unsecured path; `GET /healthz` reports whichever posture is active.
REQUIRE_AGENT_AUTH=true           # JWT + RBAC on every A2A call
REQUIRE_SIGNED_AGENT_CARDS=true   # verify signed Agent Cards (rogue-agent defense)
# Rate limiting is an ingress concern that belongs at the edge (nginx, API
# gateway); the in-process token bucket here is for single-host deployments, so
# it stays off locally and is enabled in docker-compose.
RATE_LIMIT_ENABLED=false

# Human-in-the-loop: pause HIGH/CRITICAL / SAR / sanctions-hit cases at the A2A
# INPUT_REQUIRED state for an analyst to approve/override/close before filing.
REQUIRE_HUMAN_REVIEW=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Input-validation limits
MAX_REQUEST_BYTES=262144
MAX_PARTS_PER_MESSAGE=32
MAX_TEXT_PART_CHARS=20000

# --- Reliability ------------------------------------------------------------
MAX_AGENT_ITERATIONS=6
MAX_DELEGATION_DEPTH=3
TASK_TIMEOUT_SECONDS=60
PEER_REQUEST_TIMEOUT_SECONDS=30
PEER_CONNECT_TIMEOUT_SECONDS=5
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.25
RETRY_MAX_DELAY_SECONDS=5

# --- Observability ------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- LLM (optional) ---------------------------------------------------------
# Runs fully deterministic with LLM_ENABLED=false — no API key needed.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=4096

# --- TLS (outbound peer verification) ---------------------------------------
TLS_VERIFY=true
TLS_CA_BUNDLE=
